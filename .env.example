# Copier ce fichier en .env et renseigner les valeurs (le fichier .env n'est jamais versionné)
PORT=3000
# Chaîne de connexion PostgreSQL (Neon en production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cinema
# true en production (Neon impose SSL)
DATABASE_SSL=false
# Secret de signature des jetons JWT : une longue chaîne aléatoire
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=2h
# Adresse du front autorisée par CORS
FRONT_URL=http://localhost:5173
# Fuseau horaire du cinéma
TZ=Europe/Paris
# Requêtes autorisées par minute et par adresse IP
THROTTLE_LIMIT=100
# Connexions simultanées à la base
DB_POOL_MAX=10
# Alertes du tableau de bord (US12)
ALERTE_SEUIL_REMPLISSAGE=90
ALERTE_PIC_VENTES_HEURE=50
